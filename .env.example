MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
BLOB_READ_WRITE_TOKEN=<from Vercel Storage > Blob store>

PUBLIC_SUPABASE_URL=<from Supabase Project Settings > API > Project URL>
PUBLIC_SUPABASE_ANON_KEY=<from Supabase Project Settings > API > anon public key>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase Project Settings > API > service_role key (secret)>
