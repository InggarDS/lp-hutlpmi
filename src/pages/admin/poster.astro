---
export const prerender = false;

import clientPromise from "../../lib/mongodb";

const client = await clientPromise;
const submissions = await client
  .db("lpmi_hut58")
  .collection("poster")
  .find({})
  .sort({ createdAt: -1 })
  .toArray();

const ucapanList = await client
  .db("lpmi_hut58")
  .collection("ucapan")
  .find({})
  .sort({ createdAt: -1 })
  .toArray();
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin &middot; Poster Submissions</title>
    <style>
      body { font-family: system-ui, sans-serif; background: #0a0a0a; color: #eee; margin: 0; padding: 2rem; }
      h1 { font-size: 1.4rem; margin-bottom: 1.5rem; }
      table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
      th, td { text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid #2a2a2a; vertical-align: top; }
      th { color: #999; font-weight: 600; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; }
      .status-pending { color: #e5c158; }
      .status-approved { color: #6fcf97; }
      .status-declined { color: #f26363; }
      td img { width: 60px; height: 60px; object-fit: cover; border-radius: 6px; display: block; }
      select.paket-select { background: #1a1a1a; color: #eee; border: 1px solid #444; border-radius: 6px; padding: 0.35rem 0.5rem; font-size: 0.8rem; }
      select.paket-select:disabled { opacity: 0.5; }
      .actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
      button { cursor: pointer; border: 1px solid #444; background: #1a1a1a; color: #eee; border-radius: 6px; padding: 0.4rem 0.8rem; font-size: 0.8rem; }
      button:hover { background: #2a2a2a; }
      button.decline-btn:hover { border-color: #f26363; color: #f26363; }
      button.delete-btn:hover { border-color: #f26363; background: #f26363; color: #0a0a0a; }
      button:disabled { opacity: 0.5; cursor: default; }
      h1.section { margin-top: 3rem; }
      .empty { color: #666; font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <h1>Poster Submissions</h1>
    <table>
      <thead>
        <tr>
          <th>Nama</th>
          <th>Paket</th>
          <th>Pesan</th>
          <th>File</th>
          <th>Metode Bayar</th>
          <th>Bukti Transfer</th>
          <th>Status</th>
          <th>Tanggal</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {submissions.map((s) => (
          <tr data-id={s._id.toString()}>
            <td>{s.nama}</td>
            <td>
              <select class="paket-select">
                <option value="silver" selected={s.paket === "silver"}>Silver</option>
                <option value="gold" selected={s.paket === "gold"}>Gold</option>
                <option value="platinum" selected={s.paket === "platinum"}>Platinum</option>
                <option value="diamond" selected={s.paket === "diamond"}>Diamond</option>
              </select>
            </td>
            <td>{s.pesan || "-"}</td>
            <td>
              {s.customFile && s.customFile.startsWith("http") ? (
                <a href={s.customFile} target="_blank" rel="noopener noreferrer">
                  <img src={s.customFile} alt={s.nama} />
                </a>
              ) : "-"}
            </td>
            <td>{s.metodeBayar}</td>
            <td>
              {s.buktiTransfer ? (
                <a href={s.buktiTransfer} target="_blank" rel="noopener noreferrer">
                  <img src={s.buktiTransfer} alt={`Bukti transfer ${s.nama}`} />
                </a>
              ) : "-"}
            </td>
            <td class={`status-${s.status}`}>{s.status}</td>
            <td>{new Date(s.createdAt).toLocaleString("id-ID")}</td>
            <td>
              <div class="actions">
                {s.status === "pending" && (
                  <>
                    <button class="approve-btn">Approve</button>
                    <button class="decline-btn">Decline</button>
                  </>
                )}
                <button class="delete-btn">Delete</button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <h1 class="section">Dinding Ucapan</h1>
    {ucapanList.length === 0 ? (
      <p class="empty">Belum ada ucapan.</p>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Nama</th>
            <th>Asal</th>
            <th>Ucapan</th>
            <th>Tanggal</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {ucapanList.map((u) => (
            <tr data-id={u._id.toString()}>
              <td>{u.nama}</td>
              <td>{u.asal || "-"}</td>
              <td>{u.teks}</td>
              <td>{new Date(u.createdAt).toLocaleString("id-ID")}</td>
              <td>
                <div class="actions">
                  <button class="delete-ucapan-btn">Delete</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <script>
      function withRowId(selector, handler) {
        document.querySelectorAll(selector).forEach((btn) => {
          btn.addEventListener("click", () => {
            const row = btn.closest("tr");
            const id = row?.getAttribute("data-id");
            if (id) handler(btn as HTMLButtonElement, id);
          });
        });
      }

      async function setStatus(btn: HTMLButtonElement, id: string, status: string) {
        btn.setAttribute("disabled", "true");
        const res = await fetch(`/api/poster/${id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ status }),
        });
        if (res.ok) {
          location.reload();
        } else {
          btn.removeAttribute("disabled");
          alert("Gagal mengubah status");
        }
      }

      withRowId(".approve-btn", (btn, id) => setStatus(btn, id, "approved"));
      withRowId(".decline-btn", (btn, id) => setStatus(btn, id, "declined"));

      document.querySelectorAll(".paket-select").forEach((select) => {
        select.addEventListener("change", async () => {
          const el = select as HTMLSelectElement;
          const row = el.closest("tr");
          const id = row?.getAttribute("data-id");
          if (!id) return;
          const previous = el.dataset.previous ?? el.value;
          el.setAttribute("disabled", "true");
          const res = await fetch(`/api/poster/${id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ paket: el.value }),
          });
          if (res.ok) {
            el.dataset.previous = el.value;
          } else {
            el.value = previous;
            alert("Gagal mengubah paket");
          }
          el.removeAttribute("disabled");
        });
      });

      withRowId(".delete-btn", async (btn, id) => {
        if (!confirm("Hapus pengajuan ini secara permanen?")) return;
        btn.setAttribute("disabled", "true");
        const res = await fetch(`/api/poster/${id}`, { method: "DELETE" });
        if (res.ok) {
          location.reload();
        } else {
          btn.removeAttribute("disabled");
          alert("Gagal menghapus");
        }
      });

      withRowId(".delete-ucapan-btn", async (btn, id) => {
        if (!confirm("Hapus ucapan ini secara permanen?")) return;
        btn.setAttribute("disabled", "true");
        const res = await fetch(`/api/ucapan/${id}`, { method: "DELETE" });
        if (res.ok) {
          location.reload();
        } else {
          btn.removeAttribute("disabled");
          alert("Gagal menghapus");
        }
      });
    </script>
  </body>
</html>
